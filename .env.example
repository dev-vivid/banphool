# ─── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (Prisma uses this) ───────────────────────────────
DATABASE_URL="mysql://root:your_password@localhost:3306/node_api_db"

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Security ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Logs ──────────────────────────────────────────────────────
LOG_LEVEL=debug
